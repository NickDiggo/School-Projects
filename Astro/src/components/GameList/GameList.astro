---
import steamDeals from '../../data/steam-deals.json';
---

<div id="game-list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 p-8">
    {steamDeals.map((game) => (
            <div
                    class="game-card block p-6 bg-white border border-gray-200 rounded-lg shadow-sm hover:bg-gray-100 dark:bg-gray-800 dark:border-gray-700 dark:hover:bg-gray-700"
                    data-discount={game.discountPercentage ?? 0}
            >
                <h5 class="mb-2 text-xl font-bold tracking-tight text-gray-900 dark:text-white">
                    {game.title}
                </h5>
                <p class="font-normal text-gray-700 dark:text-gray-400">
                    {game.isDiscounted ? `${game.discountPercentage}% korting` : 0}
                </p>
            </div>
    ))}
</div>