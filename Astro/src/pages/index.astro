---
import Layout from '../layouts/Layout.astro';
import SearchInput from '../components/SearchInput/SearchInput.astro';
import GameList from '../components/GameList/GameList.astro';
import steamDeals from '../data/steam-deals.json';
import DiscountRangeSlider from '../components/DiscountRangeSlider/DiscountRangeSlider.astro';
import '../astro.css';
---

<Layout>
	<div class="container "><main class="p-6 ">
		<h1 class="text-2xl font-bold mb-4 text-center p-10">Steam Deals</h1>

		<div class="flex flex-col sm:flex-row items-center gap-4 mb-6">
			<div class="w-full sm:w-1/2">
				<SearchInput id="search" placeholder="Search games..." />
			</div>

			<div class="w-full sm:w-1/3">
				<DiscountRangeSlider />
			</div>
		</div>

		<GameList games={steamDeals} />

		<script>
			const input = document.getElementById('search');
			const slider = document.getElementById('discount-slider');
			const sliderValue = document.getElementById('discount-slider-value');
			const gameCards = document.querySelectorAll('.game-card');

			function filterGames() {
				const term = input?.value.toLowerCase() || '';
				const maxDiscount = Number(slider?.value || 100);

				sliderValue.textContent = `${maxDiscount}%`;

				gameCards.forEach(card => {
					const title = card.querySelector('h5')?.textContent?.toLowerCase() || '';
					const discount = Number(card.dataset.discount ?? 0);

					// combineer zoekterm + discountfilter
					const matchesSearch = title.includes(term);
					const matchesDiscount = discount <= maxDiscount;

					card.style.display = matchesSearch && matchesDiscount ? 'block' : 'none';
				});
			}

			input?.addEventListener('input', filterGames);
			slider?.addEventListener('input', filterGames);
			filterGames();
		</script>

	</main></div>

</Layout>
